# Copy to n8n/.env on the host. Do not commit actual secret values.
N8N_HOST=workflow.example.com
N8N_WEBHOOK_URL=https://workflow.example.com/
N8N_EDITOR_BASE_URL=https://workflow.example.com/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_BASIC_AUTH_USER=operator
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# Must match the Supabase Edge Function secrets. Never put the service-role key here.
N8N_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
CALLBACK_SECRET=replace-with-at-least-32-random-characters
# Exact public host used for the Supabase Edge Function callback; no scheme/path/wildcards.
N8N_CALLBACK_ALLOWED_HOSTS=your-project.supabase.co

# OpenAI-compatible Chat Completions endpoint. Provider API key remains on the n8n host.
N8N_LLM_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
N8N_LLM_ALLOWED_HOSTS=openrouter.ai
N8N_LLM_API_KEY=replace-with-provider-key
N8N_LLM_MODEL=replace-with-allowed-model
